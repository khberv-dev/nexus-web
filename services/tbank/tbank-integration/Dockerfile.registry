# Build for Yandex Container Registry
FROM rustlang/rust:nightly-slim as builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    curl \
    cmake \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace files
COPY Cargo.toml Cargo.lock ./

# Copy all workspace members (required by Cargo workspace)
COPY shared ./shared
COPY challenge-engine ./challenge-engine
COPY billing-engine ./billing-engine
COPY erir-integration ./erir-integration
COPY tbank-integration ./tbank-integration
COPY api-export-tool ./api-export-tool

# Copy workspace-level files
COPY benches ./benches
COPY src ./src
COPY tests ./tests

# Build only this package
RUN cargo build --release --package tbank-integration

# Runtime stage
FROM debian:bookworm-slim

# Set timezone to Moscow
ENV TZ=Europe/Moscow
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Copy binary
COPY --from=builder /build/target/release/tbank-integration ./app

# Create non-root user
RUN useradd -r -s /bin/false -u 1001 appuser && \
    chown -R appuser:appuser /app

USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

EXPOSE 8080

CMD ["./app"]
