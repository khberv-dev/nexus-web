# Copy to .env and fill in real values. See docs/HANDOFF.md and docs/TECHNICAL.md for details.

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:123456@localhost:5432/nexus"

# ── Auth (NextAuth) ──────────────────────────────────────────────────────
# Public URL of the app. No trailing slash.
NEXTAUTH_URL="http://localhost:3000"
# Secret used to sign NextAuth JWTs/sessions. Min 32 chars. Generate: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me-32-characters-minimum"
# Used as a fallback base URL for building absolute links (e.g. in emails) when NEXTAUTH_URL is unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Email (Resend — magic link + notifications) ─────────────────────────
RESEND_API_KEY="re_123456789_mockApiKeyPlaceholder"
# "From" address. Either set EMAIL_FROM directly, or EMAIL_FROM_NAME + EMAIL_FROM_ADDRESS.
EMAIL_FROM="NEXUS <noreply@example.com>"
EMAIL_FROM_NAME="NEXUS"
EMAIL_FROM_ADDRESS="noreply@example.com"
# Resend sandbox mode (no verified domain yet): set to "1" to send from onboarding@resend.dev.
RESEND_SANDBOX="0"
RESEND_SANDBOX_FROM="NEXUS <onboarding@resend.dev>"
# Log magic-link URLs to the server console instead of requiring a real Resend key. Auto-on in development.
AUTH_EMAIL_DEV_LOG="1"

# ── Zitadel OIDC (optional — only registers if all of these are set) ────
ZITADEL_ISSUER="https://mock-zitadel.example.com"
ZITADEL_CLIENT_ID="000000000000000000@mock_project"
ZITADEL_PROJECT_ID="000000000000000000"
ZITADEL_ORG_ID="000000000000000000"
# JSON service-account key (as a single-line JSON string).
ZITADEL_SERVICE_ACCOUNT_KEY='{"type":"serviceaccount","keyId":"000000000000000000","key":"-----BEGIN RSA PRIVATE KEY-----\nMOCKKEY\n-----END RSA PRIVATE KEY-----\n","userId":"000000000000000000"}'
# Show the "Login with Zitadel" button on the login page.
NEXT_PUBLIC_ZITADEL_LOGIN="0"

# ── File storage ──────────────────────────────────────────────────────
# STORAGE_DRIVER=local stores uploads on this server's disk under `uploads/`
# instead of S3 — /api/storage/put and /api/storage/get serve as the local
# equivalent of S3 presigned URLs. Leave unset (or any value other than
# "local") to use the S3-compatible backend below.
STORAGE_DRIVER=""
# Secret used to sign local upload/download URL tokens. Falls back to
# NEXTAUTH_SECRET if unset. Only relevant when STORAGE_DRIVER=local.
STORAGE_URL_SECRET=""

# ── File storage (S3-compatible — cloud.ru / MinIO) ─────────────────────
S3_ENDPOINT="http://localhost:9000"
# Only needed if the public (browser-facing) endpoint differs from S3_ENDPOINT.
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="nexus-files"

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Payments (T-Bank via billing-svc) ────────────────────────────────────
BILLING_SVC_URL="http://localhost:8090"
TBANK_WEBHOOK_SECRET="mock-tbank-webhook-secret"
# Disable stage payment blocking (dev convenience). Both flags must match.
SKIP_STAGE_PAYMENTS="true"
NEXT_PUBLIC_SKIP_STAGE_PAYMENTS="true"

# ── DaData (bank/company requisite autocomplete) ─────────────────────────
DADATA_API="0000000000000000000000000000000000mock"

# ── Cloudflare Workers AI (brief/portfolio/chat suggestions) ─────────────
CF_ACCOUNT_ID="0000000000000000000000000000mock"
CF_API_KEY="mock-cf-workers-ai-token"
CF_AI_MODEL="@cf/meta/llama-3.1-8b-instruct"

# ── Sentry ────────────────────────────────────────────────────────────
SENTRY_AUTH_TOKEN="sntrys_mockAuthTokenPlaceholder"
SENTRY_DSN="https://mockpublickey@o000000.ingest.sentry.io/0000000"
NEXT_PUBLIC_SENTRY_DSN="https://mockpublickey@o000000.ingest.sentry.io/0000000"

# ── CORS / server actions ────────────────────────────────────────────
ALLOWED_ORIGINS="localhost:3000"

# ── Demo mode (/demo/login) ──────────────────────────────────────────
DEMO_ACCESS_KEY="mock-demo-access-key"
# Seed demo users/orders when running `npm run db:seed` / `npm run db:reset:demo`.
DEMO_SEED="1"

# ── Dev auth bypass (local-only; forced off when NODE_ENV=production) ───
DEV_AUTH_BYPASS="true"
DEV_MOCK_ROLE="ADMIN"
# Optional: pin the bypass to a specific User.id instead of the first user with DEV_MOCK_ROLE.
DEV_MOCK_USER_ID=""
NEXT_PUBLIC_DEV_AUTH_BYPASS="true"
NEXT_PUBLIC_DEV_MOCK_ROLE="ADMIN"
